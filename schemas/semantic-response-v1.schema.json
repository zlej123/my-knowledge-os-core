{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-response-v1.schema.json",
  "title": "My Knowledge OS Semantic Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "source_metadata", "tags", "domain", "one_sentence_summary", "problem", "method", "contributions", "reported_evidence", "stated_limitations", "domain_perspective", "implementation_considerations", "questions_and_unknowns", "related_knowledge"],
  "properties": {
    "title": { "type": "string" },
    "source_metadata": { "$ref": "#/$defs/source_metadata" },
    "tags": { "$ref": "#/$defs/string_array" },
    "domain": { "$ref": "#/$defs/string_array" },
    "one_sentence_summary": { "type": "string" },
    "problem": { "type": "string" },
    "method": { "type": "string" },
    "contributions": { "type": "string" },
    "reported_evidence": { "type": "string" },
    "stated_limitations": { "type": "string" },
    "domain_perspective": { "type": "string" },
    "implementation_considerations": { "type": "string" },
    "questions_and_unknowns": { "type": "string" },
    "related_knowledge": { "type": "string" }
  },
  "$defs": {
    "string_array": { "type": "array", "items": { "type": "string" } },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "publication_date", "doi"],
      "properties": {
        "authors": { "$ref": "#/$defs/string_array" },
        "publication_date": { "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
        "doi": { "type": ["string", "null"] }
      }
    }
  }
}
