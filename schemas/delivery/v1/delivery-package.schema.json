{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-knowledge-os.local/schemas/delivery/v1/delivery-package.schema.json",
  "title": "My Knowledge OS DeliveryPackage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "source_system",
    "payload_type",
    "source",
    "classification",
    "content",
    "destinations",
    "interaction_policy",
    "authorization",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "pattern": "^dp_[a-z0-9][a-z0-9_-]{0,126}$"
    },
    "source_system": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "payload_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "classification": {
      "enum": [
        "public",
        "personal",
        "personal_financial",
        "work",
        "restricted"
      ]
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/destination"
      }
    },
    "interaction_policy": {
      "$ref": "#/$defs/interaction_policy"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision_id",
        "content_digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "revision_id": {
          "$ref": "#/$defs/identifier"
        },
        "content_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "title",
        "summary",
        "body_markdown",
        "links"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "body_markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "links": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rel",
        "label",
        "url"
      ],
      "properties": {
        "rel": {
          "enum": [
            "source",
            "review",
            "detail"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "profile_id",
        "render_profile"
      ],
      "properties": {
        "channel": {
          "enum": [
            "console",
            "file",
            "notion",
            "telegram",
            "email",
            "webhook"
          ]
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "render_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}-v[1-9][0-9]*$"
        }
      }
    },
    "interaction_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_actions",
        "decision_authority"
      ],
      "properties": {
        "allowed_actions": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "defer",
              "remind_later",
              "feedback_candidate"
            ]
          }
        },
        "decision_authority": {
          "const": "source_system_only"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "policy_id",
        "event_id",
        "authorized_at",
        "intent_digest"
      ],
      "properties": {
        "mode": {
          "enum": [
            "human_event",
            "source_policy_event"
          ]
        },
        "policy_id": {
          "$ref": "#/$defs/identifier"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "authorized_at": {
          "type": "string",
          "format": "date-time"
        },
        "intent_digest": {
          "$ref": "#/$defs/sha256"
        },
        "actor_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
