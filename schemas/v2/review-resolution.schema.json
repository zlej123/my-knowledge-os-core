{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-knowledge-os.local/schemas/v2/review-resolution.schema.json",
  "title": "My Knowledge OS review resolution record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "record_type",
    "review_id",
    "target",
    "resulting_revision",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^personal-review-resolution-[a-f0-9]{64}$"
    },
    "record_type": { "const": "review_resolution" },
    "review_id": { "type": "string", "pattern": "^personal-review-[a-f0-9]{64}$" },
    "target": { "$ref": "#/$defs/target" },
    "resulting_revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "record_id"],
      "properties": {
        "record_type": { "enum": ["source", "knowledge"] },
        "record_id": {
          "type": "string",
          "pattern": "^personal-(source|knowledge)-[a-f0-9]{64}$"
        }
      }
    }
  }
}
