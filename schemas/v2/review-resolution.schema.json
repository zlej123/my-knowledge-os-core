{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-knowledge-os.local/schemas/v2/review-resolution.schema.json",
  "title": "My Knowledge OS review resolution record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "record_type",
    "review_id",
    "target_record_id",
    "requested_revision",
    "resulting_revision",
    "bundle_id",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^personal-review-resolution-[a-f0-9]{64}$"
    },
    "record_type": { "const": "review_resolution" },
    "review_id": { "type": "string", "pattern": "^personal-review-[a-f0-9]{64}$" },
    "target_record_id": {
      "type": "string",
      "pattern": "^personal-(source|knowledge)-[a-f0-9]{64}$"
    },
    "requested_revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "resulting_revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "bundle_id": {
      "type": "string",
      "pattern": "^prepared-content-sha256-[a-f0-9]{64}$"
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
