{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-knowledge-os.local/schemas/v2/review-feedback-input.schema.json",
  "title": "My Knowledge OS review feedback decision input v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "card_digest", "target_decisions"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^mko-review-session-[a-f0-9]{64}$"
    },
    "card_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "target_decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/target_decision" }
    }
  },
  "$defs": {
    "target_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "decision"],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^personal-(source|knowledge)-[a-f0-9]{64}$"
        },
        "decision": { "enum": ["request_changes", "defer"] },
        "feedback": { "type": ["string", "null"], "maxLength": 262144 }
      }
    }
  }
}
