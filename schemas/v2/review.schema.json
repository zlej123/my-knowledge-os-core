{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-knowledge-os.local/schemas/v2/review.schema.json",
  "title": "My Knowledge OS review record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "record_type", "targets", "created_at"],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "$ref": "#/$defs/review_id" },
    "record_type": { "const": "review" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/target" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "review_id": { "type": "string", "pattern": "^personal-review-[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "record_id": {
      "type": "string",
      "pattern": "^personal-(source|knowledge)-[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_id",
        "displayed_revision",
        "decision",
        "feedback",
        "supersedes_review_id"
      ],
      "properties": {
        "record_type": { "enum": ["source", "knowledge"] },
        "record_id": { "$ref": "#/$defs/record_id" },
        "displayed_revision": { "$ref": "#/$defs/revision" },
        "decision": { "enum": ["approve", "request_changes", "defer"] },
        "feedback": { "type": ["string", "null"], "maxLength": 262144 },
        "supersedes_review_id": {
          "anyOf": [{ "$ref": "#/$defs/review_id" }, { "type": "null" }]
        }
      }
    }
  }
}
